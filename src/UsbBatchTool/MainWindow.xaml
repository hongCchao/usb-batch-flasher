<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="24,18,24,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,16">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="USB 批量烧录工具" FontSize="27" FontWeight="Bold"/><TextBlock Text="绑定端口 · 批量写入 · 实时监控" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#E3EDFF" CornerRadius="14" Padding="12,6"><TextBlock x:Name="AccessText" Text="管理员模式" Foreground="#2256B5"/></Border><Button x:Name="SettingsButton" Content="端口与设置" Margin="12,0,0,0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="White" BorderBrush="#DFE6F1" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
    <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="ImageModeButton" Content="系统镜像烧录" IsChecked="True" GroupName="Mode" FontWeight="SemiBold" Margin="0,0,24,0"/><RadioButton x:Name="ZipModeButton" Content="ZIP 文件分发" GroupName="Mode" FontWeight="SemiBold"/></StackPanel>
        <TextBlock Grid.Column="1" x:Name="SourceSizeText" Text="IMG / IMG.GZ / ISO" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </Grid>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FilePathBox" IsReadOnly="True" Text="请选择系统镜像或 ZIP 压缩包" Foreground="#55657E"/><Button Grid.Column="1" x:Name="ChooseFileButton" Content="选择文件…" Margin="10,0,0,0"/></Grid>
      <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="最近使用" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="RecentFilesBox" Grid.Column="1" DisplayMemberPath="DisplayName"/><Button Grid.Column="2" x:Name="ClearCacheButton" Content="清理缓存与记录" Margin="12,0,0,0"/></Grid>
      <StackPanel x:Name="ZipOptionsPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed"><CheckBox x:Name="FormatCheckBox" Content="复制前重建并格式化" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="FileSystemBox" Width="90" Margin="0,0,16,0"/><TextBlock Text="同名文件" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><ComboBox x:Name="ConflictBox" Width="145"/></StackPanel>
      <TextBlock x:Name="ModeHintText" Text="镜像写入会清除目标 U 盘所有分区；支持重复烧录、无盘符及 Linux 分区。" Foreground="#9C5B0C" TextWrapping="Wrap" Margin="0,11,0,0"/>
      <TextBlock x:Name="HashText" Text="选择记录会自动保存；压缩文件按 SHA-256 复用解压缓存。" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
    </StackPanel>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="已绑定端口" FontSize="17" FontWeight="SemiBold" Margin="0,0,18,0"/><Button x:Name="SelectAllButton" Content="全选" Padding="12,6"/><Button x:Name="SelectNoneButton" Content="取消全选" Padding="12,6"/><TextBlock x:Name="SelectionText" Text="已选 0 台" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Column="1"><Button x:Name="WizardButton" Content="逐口识别向导" Padding="12,6"/><Button x:Name="ManualBindButton" Content="管理端口" Padding="12,6"/><Button x:Name="RefreshButton" Content="刷新设备" Padding="12,6" Margin="0"/></StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
    <StackPanel><TextBlock x:Name="UnboundText" Foreground="#9C5B0C" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
    <ItemsControl x:Name="PortsItems" HorizontalContentAlignment="Stretch">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border x:Name="CardBorder" Margin="0,0,6,0" Padding="9,8" CornerRadius="10" BorderThickness="1" Background="White" BorderBrush="#DCE4F0" ToolTip="{Binding Details}">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PortLabel}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" ToolTip="选择此设备"/></Grid>
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            <Image Source="{Binding StateImage}" Height="44" Stretch="Uniform" Margin="0,1,0,1"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StateText" Text="{Binding StateText}" TextTrimming="CharacterEllipsis" Foreground="#53627A" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding CapacityText}" FontSize="11" FontWeight="SemiBold"/></Grid>
            <TextBlock Text="{Binding DeviceText}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding VolumeText}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding FreeText}" FontSize="10" Foreground="{StaticResource Muted}" Height="15" Margin="0,1,0,4"/>
            <ProgressBar Value="{Binding Progress}" Maximum="100"/>
            <TextBlock Text="{Binding Stage}" FontSize="10" Margin="0,4,0,1"/>
            <TextBlock Text="{Binding ProgressDetail}" FontSize="10" Height="18" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter TargetName="StateText" Property="Foreground" Value="#157957"/></DataTrigger>
          <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="CardBorder" Property="Background" Value="#F8FAFF"/></DataTrigger>
          <DataTrigger Binding="{Binding HasError}" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#DC4D4D"/></DataTrigger>
          <DataTrigger Binding="{Binding HasWriteFailure}" Value="True"><Setter TargetName="StateText" Property="Foreground" Value="#DC4D4D"/></DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl></StackPanel>
  </ScrollViewer>
  <Border Grid.Row="4" CornerRadius="10" Background="White" BorderBrush="#DFE6F1" BorderThickness="1" Padding="15,12" Margin="0,0,0,12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="实时操作日志" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ClearLogButton" Content="清空显示" Padding="8,3" FontSize="11"/><Button x:Name="ExportLogButton" Content="导出日志" Padding="8,3" FontSize="11" Margin="0"/></StackPanel></Grid>
      <ListBox x:Name="LogList" Grid.Row="1" BorderThickness="0" Margin="0,8,0,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeText}" Foreground="#8290A5"/><TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="#5B6E8A"/><TextBlock Grid.Column="2" Text="{Binding Port}" Foreground="#4B6B9F"/><TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBlock x:Name="TaskSummaryText" Grid.Row="2" Text="准备就绪" Foreground="{StaticResource Muted}" FontSize="11"/>
    </Grid>
  </Border>
  <Grid Grid.Row="5" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="OverallText" Text="等待选择源文件与设备" Margin="0,0,0,7"/><ProgressBar x:Name="OverallProgress" Height="9" Maximum="100"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="取消任务" IsEnabled="False"/><Button x:Name="StartButton" Content="一键烧录" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="28,12" Margin="0"/></StackPanel></Grid>
</Grid>
